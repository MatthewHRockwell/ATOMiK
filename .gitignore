hardware/zynq/output/
hardware/zynq/reports/
hardware/zynq/.Xil/
hardware/zynq/vivado/atomik_zynq/
*.jou
*.bit
*.xsa
*.dcp

# Bitstreams (The compiled binary for the board)
# Generally, you don't commit these to source control,
# but you can comment these out if you want to share the binary.
*.fs
*.bin

# Intermediate object files
*.o
*.out

# --- Vendor Temporary Files ---
*_tmp.v

