your_video.mp4
*.mp4
*.avi
*.mov
*.mkv

# --- Python & Jupyter ---
# Python bytecode (garbage files)
__pycache__/
*.py[cod]

# Jupyter Notebook checkpoints (created by Colab/Jupyter)
.ipynb_checkpoints/

# --- OS Specific ---
# Mac
.DS_Store
# Windows
Thumbs.db
desktop.ini

# --- Hardware / FPGA (Gowin & Verilog) ---
# Simulation waveforms (These get huge, do not upload)
*.vcd
*.fst
*.lxt
*.wlf

# Compiled simulation executables (Icarus Verilog)
*.vvp
a.out
sim_par
sim_cmp
hardware/v3/sim/iverilog/tb_*
!hardware/v3/sim/iverilog/tb_*.v

# Synthesis logs (regenerable)
hardware/v3/synth/*.log

# Gowin EDA Build Artifacts
# 'impl' and 'temp' contain intermediate synthesis files
hardware/impl/
temp/
archive/

# Gowin Project Files & Settings
*.gprj
*.gprj.user

# Gowin Synthesis Sweep Generated Files
hardware/sweep/pll/
hardware/sweep/results/
hardware/sweep/sdc/
hardware/sweep/tcl/
hardware/sweep/top/
hardware/sweep/project_*/
hardware/sweep/impl/
hardware/v3/synth/impl/
hardware/v3/sweep/impl/
hardware/v3/sweep/pll/
hardware/v3/sweep/tcl/
hardware/v3/sweep/top/
hardware/v3/sweep/sdc/
hardware/v3/sweep/project_*/

